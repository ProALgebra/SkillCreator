{
  "name": "opencode-skill-curator",
  "version": "0.3.1",
  "description": "Durable, proposal-first skill management for OpenCode and external workers",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ProALgebra/SkillCreator.git"
  },
  "engines": {
    "node": ">=22.21.1"
  },
  "exports": {
    ".": "./dist/server.js",
    "./server": "./dist/server.js",
    "./tui": "./dist/tui.js",
    "./rpc": "./dist/rpc.js"
  },
  "types": "./dist/server.d.ts",
  "files": [
    "dist",
    "README.md",
    "docs",
    "examples",
    "LICENSE",
    "TASKS.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && babel dist/tui.jsx --out-file dist/tui.js && node scripts/clean-build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "prepack": "npm run build",
    "format": "prettier --write src test examples scripts .github docs README.md TASKS.md package.json tsconfig.json babel.config.json .prettierrc.json",
    "format:check": "prettier --check src test examples scripts .github docs README.md TASKS.md package.json tsconfig.json babel.config.json .prettierrc.json",
    "test:bun": "bun test/bun-smoke.ts",
    "test:tui": "bun --conditions=browser test/tui-smoke.ts",
    "test:live": "node scripts/live-smoke.mjs",
    "test:refine:live": "node scripts/refine-live.mjs",
    "test:optimizer:live": "node scripts/optimizer-live.mjs",
    "test:package": "node scripts/package-smoke.mjs"
  },
  "dependencies": {
    "@opencode/client": "2.3.0",
    "@opencode/plugin": "2.3.0",
    "better-sqlite3": "11.10.0",
    "diff": "9.0.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@babel/cli": "7.28.0",
    "@babel/core": "7.29.13",
    "@opentui/core": "0.8.4",
    "@opentui/solid": "0.8.4",
    "@types/better-sqlite3": "7.6.13",
    "@types/diff": "7.0.2",
    "@types/node": "22.15.30",
    "babel-preset-solid": "1.9.9",
    "bun": "1.3.14",
    "prettier": "3.6.2",
    "solid-js": "1.9.17",
    "tsx": "4.20.3",
    "typescript": "5.8.3"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.8.4",
    "@opentui/solid": ">=0.8.4",
    "solid-js": ">=1.9.17"
  },
  "peerDependenciesMeta": {
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  }
}
