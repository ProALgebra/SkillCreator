{
  "valeria_bridge": { "enabled": true, "lease_seconds": 120 },
  "execution": {
    "default_mode": "auto",
    "auto_preferred_modes": ["direct", "session", "valeria"],
    "operation_modes": { "learning": "direct", "review": "session", "merge": "valeria" }
  },
  "privacy": { "send_raw_transcripts_to_external": false },
  "limits": { "daily_cost_usd": null, "max_job_cost_usd": null, "max_context_tokens": 45000 },
  "curator": { "llm_review_enabled": true },
  "approval": {
    "mode": "auto",
    "allow_auto_create": true,
    "allow_auto_merge": true,
    "allow_auto_patch_managed_low_risk": true,
    "allow_auto_archive_managed": true
  }
}
